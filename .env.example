# Client ID приложения из https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
# Необязательно: по умолчанию используется адрес, с которого открыто приложение
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/

# Ключ Claude API для AI-вердикта и микс-плейлиста. Только на сервере, в браузер не попадает.
# ANTHROPIC_API_KEY=

# Короткие ссылки-приглашения (Upstash Redis). На Vercel добавляются сами при подключении
# Storage → Upstash for Redis. Без них локально ссылки хранятся в памяти процесса.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
