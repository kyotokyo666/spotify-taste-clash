# Client ID приложения из https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=
# Необязательно: по умолчанию используется адрес, с которого открыто приложение
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/

# Ключ Claude API для AI-вердикта и микс-плейлиста. Только на сервере — без префикса VITE_.
# ANTHROPIC_API_KEY=
